# 生产环境：SSO 统一登录（sso_login 项目，经 nginx 反代，HTTPS 7443 端口）
VITE_SSO_BASE_URL=https://todo.hetou.vip:7443
VITE_SSO_CLIENT_ID=repo-cms
# SSO 授权回跳地址按当前 origin 自动派生（origin + /#/landing/sso/callback），无需配置
# 回跳地址已在 SSO 库 oauth_clients.redirect_uris 登记：https://wms.hetou.vip:6443/#/landing/sso/callback

# 本地账号密码登录开关：true（默认）折叠保留入口；false 彻底隐藏入口（服务端接口不动，可随时回退）
VITE_PASSWORD_LOGIN_ENABLED=true
